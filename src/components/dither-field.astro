---

---

<canvas
  class="dither-field"
  aria-hidden="true"
></canvas>

<style>
  .dither-field {
    position: absolute;
    inset: 0;
    z-index: 0;
    display: block;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }
</style>

<script>
  /**
   * Procedural ordered-dither field (see design.md §8 "Procedural dither field").
   *
   * A scalar wave field is sampled on a fixed grid, thinned toward the top/left by
   * a corner falloff, and rendered through a high-frequency noise threshold. The
   * threshold drives dot *density*, the field value drives each mark's *brightness
   * and shape* — that combination is what produces the halftone crosshatch look.
   */

  const CELL = 6; // grid pitch in CSS px
  const FPS = 30;
  const FRAME_MS = 1000 / FPS;
  const MAX_DPR = 2;
  const POINTER_RADIUS = 120; // CSS px
  const POINTER_GAIN = 0.55; // added to the field value at the cursor centre
  const POINTER_EASE = 0.12; // per-frame lerp of the highlight's overall strength
  const POINTER_IDLE_MS = 1400; // cursor stillness after which the highlight fades
  /**
   * The head of the highlight sits on the raw cursor position, so tracking is
   * instant. The tail is built from recent positions sampled per pointer event —
   * including the sub-frame positions the browser coalesces — rather than once per
   * rendered frame, so a fast sweep leaves a continuous streak instead of a chain
   * of separate blobs.
   */
  const TRAIL_MS = 420; // how long a position keeps contributing to the tail
  const TRAIL_CAPACITY = 96; // ring buffer size; covers TRAIL_MS at ~230Hz
  /** Decay exponent along the tail. Higher means a shorter, tighter trail. */
  const TRAIL_DECAY = 2.2;
  /**
   * The halo is not a circle. Its radius is bent by a two-lobe and a three-lobe
   * harmonic that drift out of phase with each other, so the highlight reads as a
   * living smudge rather than a stamped dot. Kept well under 1 so it never pinches
   * the radius to nothing.
   */
  const WOBBLE = 0.34;
  /** Radians per second the two lobes rotate through. */
  const WOBBLE_SPEED = 1.15;
  const FIELD_BIAS = 0.86; // dot density at the anchored corner, before waves
  const CONTRAST = 0.78; // how hard the waves swing density around that bias
  /**
   * Falloff reach, as a fraction of the canvas diagonal. Measuring the distance in
   * pixels rather than in normalised coordinates keeps the field's shape roughly
   * circular on any aspect ratio: on a tall phone viewport it spreads across the
   * full width instead of collapsing into a squashed vertical sliver.
   */
  const REACH_RADIUS = 1;
  /** Divides the horizontal distance. Above 1 stretches the field sideways. */
  const CORNER_STRETCH = 1.3;
  /**
   * Exponent on the corner falloff. The canvas spans the whole page, but a higher
   * value pulls the texture tighter into the anchored corner and lets the rest of
   * the page fall to bare surface with no dots at all.
   */
  const FOCUS = 3;
  /** Multiplier on the wave frequencies. Higher means smaller, finer blobs. */
  const BLOB_SCALE = 2.1;
  /**
   * Below this field value a cell draws nothing at all. The falloff only reaches
   * exactly zero in the opposite corner, so without a floor the whole far side of
   * the page keeps passing the threshold in about one cell per hundred — a thin
   * dusting of lone darkest specks with no visible blob to belong to. Applied after
   * the cursor and selection contributions, so both still work out there.
   */
  const VALUE_FLOOR = 0.09;

  /**
   * Text selection is rendered as the field itself: the native highlight is turned
   * transparent and the field's density is raised inside the selection rectangles
   * instead. `::selection` only honours `background-color` in browsers, so a
   * patterned highlight is not reachable from CSS — but the canvas already sits
   * behind the text, so filling it there works.
   *
   * The selection raises the falloff rather than forcing a fixed value, so the wave
   * field still runs through it and the region breaks into the same blobs and the
   * same mix of marks as the corner. Forcing a value instead produced a flat slab of
   * identical brightest blocks. It has to override the corner falloff, or a
   * selection over the heading would land where the field carries no dots at all.
   */
  const SELECTION_REACH = 0.7;
  /**
   * Line boxes are rectangles, and a rectangle reads as a bar no matter how its
   * interior is dithered. So the coverage is blurred before use: corners round off
   * and neighbouring lines merge into one mass instead of stacking as slabs. The
   * radius is in cells and has to exceed the gap between lines for them to join.
   */
  const SELECTION_BLUR_CELLS = 3;
  const SELECTION_BLUR_PASSES = 2; // two box passes approximate a Gaussian
  /**
   * Remap window for the blurred coverage, plus how far the wave field is allowed to
   * displace the contour. The wobble is what keeps the outline irregular rather than
   * a tidy rounded rectangle, and it comes free from the wave already computed.
   */
  const SELECTION_EDGE_LOW = 0.3;
  const SELECTION_EDGE_HIGH = 0.72;
  const SELECTION_WOBBLE = 0.34;
  /** Guard against pathological selections; well above any real line count here. */
  const SELECTION_MAX_RECTS = 96;

  /**
   * Entrance sweep. Rather than fading opacity, the reveal grows the dot density
   * outward from the anchored corner: the wavefront advances across the falloff
   * and the dither threshold frays its leading edge, so the field assembles itself
   * out of the surface instead of appearing on top of it.
   */
  const INTRO_MS = 1300;
  /** Held back so the field trails the staggered text reveal in index.astro. */
  const INTRO_DELAY_MS = 220;
  /** Width of the soft front, in `reach` units. Wider means a longer frayed edge. */
  const INTRO_EDGE = 0.24;
  /**
   * Where the front stops. Below this `reach` the falloff leaves no dots anyway, so
   * ending here spends the whole duration on the part of the sweep that is visible
   * instead of trailing off through empty surface.
   */
  const INTRO_FRONT_END = 0.28;
  /** Ease-out exponent. Near-linear keeps the front travelling at a readable pace. */
  const INTRO_EASE = 1.7;

  /**
   * Dither threshold field: interleaved gradient noise. This replaces a Bayer 4x4
   * matrix, whose 16 fixed sub-positions each carried a wildly different threshold
   * (measured hit rates from 0.004 to 1.000) and stamped a visible crosshatch grid
   * repeating every four cells. These weights spread the thresholds evenly with no
   * repeat period at all, so the dithering reads as texture rather than as a lattice.
   *
   * Note this is not void-and-cluster blue noise; it is a cheap high-frequency hash
   * that needs no lookup table. Good enough at this dot pitch.
   */
  const NOISE_COL = 0.06711056;
  const NOISE_ROW = 0.00583715;
  const NOISE_GAIN = 52.9829189;

  /**
   * Four brightness steps, all zero chroma, ascending. These read far darker than
   * they look in isolation: at this pitch a dot covers under a fifth of its cell,
   * so the field's perceived lightness stays well below its brightest tone.
   */
  const TONES_OKLCH = [
    "oklch(20% 0 0)",
    "oklch(28% 0 0)",
    "oklch(36% 0 0)",
    "oklch(44% 0 0)",
  ];
  /** sRGB greys matching the tones above, for engines without oklch() on canvas. */
  const TONES_SRGB = ["#161616", "#292929", "#3d3d3d", "#525252"];
  /**
   * One mark per brightness step, sparsest first: speck, dot, cross, block. Varying
   * the mark's *shape* and not only its size is what gives the field its crosshatch
   * character instead of reading as four sizes of the same square.
   *
   * Every size keeps `(CELL - size) / 2` a whole or half pixel so the marks land on
   * device pixels at both 1x and 2x. A 1.5px mark would sit at offset 2.25 and get
   * antialiased into a second, muddier tone.
   */
  const SQUARE_SIZES = [1, 2, 0, 3]; // index CROSS_LEVEL is unused
  const CROSS_LEVEL = 2;
  const CROSS_ARM = 4;
  const CROSS_THICKNESS = 1;
  const LEVELS = TONES_OKLCH.length;

  function supportsOklch(ctx: CanvasRenderingContext2D): boolean {
    const sentinel = "#123456";
    const previous = ctx.fillStyle;
    ctx.fillStyle = sentinel;
    ctx.fillStyle = TONES_OKLCH[0]!;
    const supported = ctx.fillStyle !== sentinel;
    ctx.fillStyle = previous;
    return supported;
  }

  function init(canvas: HTMLCanvasElement): void {
    const ctx = canvas.getContext("2d", { alpha: true });
    if (!ctx) return;

    const tones = supportsOklch(ctx) ? TONES_OKLCH : TONES_SRGB;
    const reduceMotion = matchMedia("(prefers-reduced-motion: reduce)");
    const finePointer = matchMedia("(hover: hover) and (pointer: fine)");

    let width = 0;
    let height = 0;
    let cols = 0;
    let rows = 0;
    /** Per-level scratch buffers of dot coordinates, sized on resize. */
    let buckets: Float32Array[] = [];
    const counts = new Uint32Array(LEVELS);

    /** Falloff reach in CSS px, recomputed whenever the canvas is resized. */
    let reachRadius = 1;

    let rect = canvas.getBoundingClientRect();
    // Cursor position in canvas-local CSS px; `strength` fades the effect in/out.
    let targetX = 0;
    let targetY = 0;
    let targetStrength = 0;
    let strength = 0;

    // Ring buffer of recent cursor positions with timestamps, newest last written.
    const trailX = new Float32Array(TRAIL_CAPACITY);
    const trailY = new Float32Array(TRAIL_CAPACITY);
    const trailAt = new Float64Array(TRAIL_CAPACITY);
    let trailHead = 0;
    let trailCount = 0;
    /**
     * Per-cell highlight contribution. Scattering the trail into this buffer once
     * per frame keeps the cost proportional to the trail's own footprint instead of
     * testing every cell against every trail sample.
     */
    let influence = new Float32Array(0);
    /** Per-cell selection coverage 0..1, rebuilt whenever the selection changes. */
    let selectionMask = new Float32Array(0);
    /** Scratch for the separable blur; avoids allocating on every selection change. */
    let selectionScratch = new Float32Array(0);
    let selectionActive = false;

    let rafId = 0;
    let lastFrame = 0;
    let introStart = 0;
    let resizeTimer = 0;
    let idleTimer = 0;

    function measure(): void {
      rect = canvas.getBoundingClientRect();
    }

    function resize(): void {
      measure();
      const nextWidth = Math.max(1, Math.round(rect.width));
      const nextHeight = Math.max(1, Math.round(rect.height));
      if (nextWidth === width && nextHeight === height) return;

      width = nextWidth;
      height = nextHeight;
      cols = Math.ceil(width / CELL);
      rows = Math.ceil(height / CELL);
      reachRadius = REACH_RADIUS * Math.hypot(width / CORNER_STRETCH, height);

      const dpr = Math.min(window.devicePixelRatio || 1, MAX_DPR);
      canvas.width = Math.round(width * dpr);
      canvas.height = Math.round(height * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Worst case every cell lands in the same bucket, so each holds all cells.
      const capacity = cols * rows * 2;
      buckets = Array.from(
        { length: LEVELS },
        () => new Float32Array(capacity),
      );
      influence = new Float32Array(cols * rows);
      selectionMask = new Float32Array(cols * rows);
      selectionScratch = new Float32Array(cols * rows);
      readSelection();
    }

    /**
     * Marks the cells covered by the current text selection. One line box per rect,
     * so a multi-line selection produces one band per line, matching what the native
     * highlight would have drawn.
     */
    function readSelection(): void {
      if (selectionActive) selectionMask.fill(0);
      selectionActive = false;
      if (selectionMask.length === 0) return;

      const selection = document.getSelection();
      if (!selection || selection.isCollapsed) return;

      let marked = 0;
      for (let r = 0; r < selection.rangeCount; r++) {
        for (const box of selection.getRangeAt(r).getClientRects()) {
          if (box.width <= 0 || box.height <= 0) continue;
          if (++marked > SELECTION_MAX_RECTS) break;

          const left = box.left - rect.left;
          const top = box.top - rect.top;
          const colMin = Math.max(0, Math.floor(left / CELL));
          const colMax = Math.min(
            cols - 1,
            Math.ceil((left + box.width) / CELL),
          );
          const rowMin = Math.max(0, Math.floor(top / CELL));
          const rowMax = Math.min(
            rows - 1,
            Math.ceil((top + box.height) / CELL),
          );

          for (let row = rowMin; row <= rowMax; row++) {
            const rowOffset = row * cols;
            for (let col = colMin; col <= colMax; col++) {
              selectionMask[rowOffset + col] = 1;
            }
          }
          selectionActive = true;
        }
      }

      // Blur the hard union of line boxes into one smooth field. The draw pass then
      // re-thresholds it, which is what turns it from a rectangle into a blob.
      if (selectionActive) blurSelection();
    }

    /** Separable box blur over the mask, via a running sum so it stays cheap. */
    function blurSelection(): void {
      const radius = SELECTION_BLUR_CELLS;
      const span = radius * 2 + 1;

      for (let pass = 0; pass < SELECTION_BLUR_PASSES; pass++) {
        for (let row = 0; row < rows; row++) {
          const offset = row * cols;
          let sum = 0;
          for (let col = 0; col <= radius && col < cols; col++) {
            sum += selectionMask[offset + col]!;
          }
          for (let col = 0; col < cols; col++) {
            selectionScratch[offset + col] = sum / span;
            const add = col + radius + 1;
            const drop = col - radius;
            if (add < cols) sum += selectionMask[offset + add]!;
            if (drop >= 0) sum -= selectionMask[offset + drop]!;
          }
        }

        for (let col = 0; col < cols; col++) {
          let sum = 0;
          for (let row = 0; row <= radius && row < rows; row++) {
            sum += selectionScratch[row * cols + col]!;
          }
          for (let row = 0; row < rows; row++) {
            selectionMask[row * cols + col] = sum / span;
            const add = row + radius + 1;
            const drop = row - radius;
            if (add < rows) sum += selectionScratch[add * cols + col]!;
            if (drop >= 0) sum -= selectionScratch[drop * cols + col]!;
          }
        }
      }
    }

    /**
     * Stamps one halo into `influence`. Takes the strongest contribution per cell
     * rather than summing: a slow cursor piles many samples into one spot, and
     * adding those would blow the head out into a solid blob.
     */
    function scatter(
      cx: number,
      cy: number,
      weight: number,
      phase: number,
    ): void {
      // Lobe strengths for this instant. They drift at different rates so the
      // outline never settles into a repeating shape.
      const lobe2Amp = WOBBLE * 0.6 * Math.sin(phase);
      const lobe3Amp = WOBBLE * 0.4 * Math.cos(phase * 0.7);

      // The bbox has to cover the widest the outline can bulge, not the base radius.
      const maxRadius = POINTER_RADIUS * (1 + WOBBLE);
      const colMin = Math.max(0, Math.floor((cx - maxRadius) / CELL));
      const colMax = Math.min(cols - 1, Math.ceil((cx + maxRadius) / CELL));
      const rowMin = Math.max(0, Math.floor((cy - maxRadius) / CELL));
      const rowMax = Math.min(rows - 1, Math.ceil((cy + maxRadius) / CELL));
      const maxRadiusSq = maxRadius * maxRadius;

      for (let row = rowMin; row <= rowMax; row++) {
        const dy = row * CELL - cy;
        const rowOffset = row * cols;
        for (let col = colMin; col <= colMax; col++) {
          const dx = col * CELL - cx;
          const distSq = dx * dx + dy * dy;
          if (distSq >= maxRadiusSq) continue;

          const dist = Math.sqrt(distSq);
          let radius = POINTER_RADIUS;
          if (dist > 0.001) {
            // Unit direction, then sin(2θ) and cos(3θ) built from it directly —
            // cheaper than an atan2 per cell and there are a lot of cells.
            const ux = dx / dist;
            const uy = dy / dist;
            const lobe2 = 2 * ux * uy;
            const lobe3 = ux * (4 * ux * ux - 3);
            radius *= 1 + lobe2Amp * lobe2 + lobe3Amp * lobe3;
          }
          if (dist >= radius) continue;

          const near = 1 - dist / radius;
          const contribution = near * near * weight;
          const index = rowOffset + col;
          if (contribution > influence[index]!) influence[index] = contribution;
        }
      }
    }

    /** Rebuilds the highlight: full-weight head at the cursor, aged tail behind. */
    function buildInfluence(now: number): void {
      influence.fill(0);
      if (strength <= 0.001) return;

      const phase = now * 0.001 * WOBBLE_SPEED;

      // The head is the live cursor position, never an aged sample, so it survives
      // even when the cursor holds still and no new events arrive.
      scatter(targetX, targetY, POINTER_GAIN * strength, phase);

      for (let i = 0; i < trailCount; i++) {
        const at = (trailHead - 1 - i + TRAIL_CAPACITY) % TRAIL_CAPACITY;
        const age = now - trailAt[at]!;
        if (age >= TRAIL_MS) break; // older entries are older still
        const fade = 1 - age / TRAIL_MS;
        const weight = Math.pow(fade, TRAIL_DECAY) * POINTER_GAIN * strength;
        if (weight <= 0.001) continue;
        // Roll the phase back along the tail so it writhes instead of reading as
        // one rigid extruded tube.
        scatter(trailX[at]!, trailY[at]!, weight, phase - (1 - fade) * 0.9);
      }
    }

    function draw(seconds: number, intro = 1): void {
      if (width === 0 || height === 0) return;
      ctx!.clearRect(0, 0, width, height);
      counts.fill(0);

      buildInfluence(seconds * 1000);
      const pointerActive = strength > 0.001;

      // The `reach` value the entrance front currently sits at: starts beyond the
      // corner so the first frame is empty, and travels down to INTRO_FRONT_END.
      // Once the sweep is done the gate is skipped entirely.
      const sweeping = intro < 1;
      const frontStart = 1 + INTRO_EDGE;
      const front = frontStart - intro * (frontStart - INTRO_FRONT_END);

      for (let row = 0; row < rows; row++) {
        const y = row * CELL;
        const ny = y / height;
        const distY = height - y;
        const distYSq = distY * distY;

        for (let col = 0; col < cols; col++) {
          const x = col * CELL;
          const nx = x / width;

          const index = row * cols + col;
          const coverage = selectionActive ? selectionMask[index]! : 0;

          // Density falls off with pixel distance from the bottom-right corner, all
          // the way to zero, so everything beyond the reach stays bare surface.
          const distX = (width - x) / CORNER_STRETCH;
          const reach = 1 - Math.sqrt(distX * distX + distYSq) / reachRadius;
          if (reach <= 0 && coverage <= 0) continue;

          const wave =
            0.5 +
            0.26 * Math.sin(nx * 7.4 * BLOB_SCALE + seconds * 0.45) +
            0.22 * Math.sin(ny * 5.1 * BLOB_SCALE - seconds * 0.32) +
            0.2 * Math.sin((nx + ny) * 4.3 * BLOB_SCALE + seconds * 0.6) +
            0.14 *
              Math.sin(
                (nx * 2.1 - ny * 1.7) * 9.5 * BLOB_SCALE - seconds * 0.5,
              );

          // Re-threshold the blurred coverage, letting the wave push the contour
          // around. That is what turns the blurred line boxes into a drifting blob
          // rather than a rounded rectangle.
          let selected = 0;
          if (coverage > 0) {
            const shifted = coverage + (wave - 0.5) * SELECTION_WOBBLE;
            const t =
              (shifted - SELECTION_EDGE_LOW) /
              (SELECTION_EDGE_HIGH - SELECTION_EDGE_LOW);
            selected = t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t);
          }

          let falloff = reach > 0 ? Math.pow(reach, FOCUS) : 0;
          if (sweeping) {
            // Cells the front has not reached yet stay empty; the band just behind
            // it ramps in, and the dither threshold frays that ramp into an edge.
            const edge = (reach - front) / INTRO_EDGE;
            falloff *= edge <= 0 ? 0 : edge < 1 ? edge : 1;
          }

          // Lift, not override: whichever is denser wins, and the wave still runs
          // through it so the selection breaks into blobs like the rest of the field.
          const lifted = selected * SELECTION_REACH;
          if (lifted > falloff) falloff = lifted;

          // The bias sets how solid the corner gets; the waves swing density
          // around it so the field breaks into distinct dense and sparse
          // regions instead of reading as one smooth ramp.
          let value = (FIELD_BIAS + (wave - 0.5) * CONTRAST) * falloff;

          if (pointerActive) value += influence[index]!;

          if (value <= VALUE_FLOOR) continue;

          // The noise threshold decides *whether* the mark exists.
          const seed = (NOISE_COL * col + NOISE_ROW * row) % 1;
          if (value <= (NOISE_GAIN * seed) % 1) continue;

          // Field value decides *how bright and large* it is.
          const level = Math.min(LEVELS - 1, Math.floor(value * LEVELS));
          const bucket = buckets[level]!;
          const at = counts[level]! * 2;
          bucket[at] = x;
          bucket[at + 1] = y;
          counts[level]++;
        }
      }

      // One fillStyle per level rather than per mark: four state changes a frame.
      for (let level = 0; level < LEVELS; level++) {
        const count = counts[level]!;
        if (count === 0) continue;
        const bucket = buckets[level]!;
        ctx!.fillStyle = tones[level]!;

        if (level === CROSS_LEVEL) {
          const inset = (CELL - CROSS_ARM) / 2;
          const mid = (CELL - CROSS_THICKNESS) / 2;
          for (let i = 0; i < count; i++) {
            const x = bucket[i * 2]!;
            const y = bucket[i * 2 + 1]!;
            ctx!.fillRect(x + inset, y + mid, CROSS_ARM, CROSS_THICKNESS);
            ctx!.fillRect(x + mid, y + inset, CROSS_THICKNESS, CROSS_ARM);
          }
          continue;
        }

        const size = SQUARE_SIZES[level]!;
        const offset = (CELL - size) / 2;
        for (let i = 0; i < count; i++) {
          ctx!.fillRect(
            bucket[i * 2]! + offset,
            bucket[i * 2 + 1]! + offset,
            size,
            size,
          );
        }
      }
    }

    function frame(now: number): void {
      rafId = requestAnimationFrame(frame);
      if (now - lastFrame < FRAME_MS - 0.5) return;
      lastFrame = now;

      if (introStart === 0) introStart = now;
      const elapsed = now - introStart - INTRO_DELAY_MS;
      const t = elapsed <= 0 ? 0 : Math.min(1, elapsed / INTRO_MS);
      const intro = 1 - Math.pow(1 - t, INTRO_EASE);

      // Hold the highlight back until the sweep lands, so an early cursor cannot
      // punch dots through the advancing front.
      strength =
        intro < 1 ? 0 : strength + (targetStrength - strength) * POINTER_EASE;

      // While the highlight is out, drop the history so returning to the page
      // cannot draw a streak from wherever the cursor last was.
      if (strength <= 0.001) trailCount = 0;

      draw(now * 0.001, intro);
    }

    let visible = true;
    let running = false;

    function start(): void {
      if (running || reduceMotion.matches) return;
      running = true;
      lastFrame = 0;
      rafId = requestAnimationFrame(frame);
    }

    function stop(): void {
      if (!running) return;
      running = false;
      cancelAnimationFrame(rafId);
    }

    function sync(): void {
      if (visible && !document.hidden) start();
      else stop();
    }

    function pushTrail(clientX: number, clientY: number, at: number): void {
      trailX[trailHead] = clientX - rect.left;
      trailY[trailHead] = clientY - rect.top;
      trailAt[trailHead] = at;
      trailHead = (trailHead + 1) % TRAIL_CAPACITY;
      if (trailCount < TRAIL_CAPACITY) trailCount++;
    }

    function onPointerMove(event: PointerEvent): void {
      if (!finePointer.matches) return;
      targetX = event.clientX - rect.left;
      targetY = event.clientY - rect.top;

      // Coalesced events carry the positions the browser merged into this one, so
      // the trail follows the pointer's real sampling rate, not the frame rate.
      const merged = event.getCoalescedEvents?.() ?? [];
      if (merged.length > 1) {
        for (const sample of merged) {
          pushTrail(sample.clientX, sample.clientY, sample.timeStamp);
        }
      } else {
        pushTrail(event.clientX, event.clientY, event.timeStamp);
      }
      const inside =
        targetX > -POINTER_RADIUS &&
        targetY > -POINTER_RADIUS &&
        targetX < width + POINTER_RADIUS &&
        targetY < height + POINTER_RADIUS;
      targetStrength = inside ? 1 : 0;

      // A resting cursor is not attention, so let the highlight settle back out.
      // The existing lerp handles the easing; this only retargets it.
      clearTimeout(idleTimer);
      idleTimer = window.setTimeout(onPointerIdle, POINTER_IDLE_MS);
    }

    function onPointerIdle(): void {
      targetStrength = 0;
    }

    function onPointerLeave(): void {
      clearTimeout(idleTimer);
      targetStrength = 0;
    }

    function onResize(): void {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        resize();
        if (reduceMotion.matches) draw(0);
      }, 120);
    }

    function onMotionPreferenceChange(): void {
      if (reduceMotion.matches) {
        stop();
        targetStrength = 0;
        strength = 0;
        draw(0);
      } else {
        sync();
      }
    }

    function onSelectionChange(): void {
      readSelection();
      // The animation loop picks this up on its next frame; the static branch has
      // no loop, so it has to repaint here.
      if (reduceMotion.matches) draw(0);
    }

    resize();

    // Hand the highlight over to the canvas. Until this runs the native
    // `::selection` colour stays in place, so selection still works without JS.
    document.documentElement.dataset.ditherSelection = "";
    document.addEventListener("selectionchange", onSelectionChange);

    if (reduceMotion.matches) {
      // Static single frame: the texture is present, nothing moves.
      draw(0);
    } else {
      const observer = new IntersectionObserver(
        (entries) => {
          visible = entries.some((entry) => entry.isIntersecting);
          sync();
        },
        { rootMargin: "64px" },
      );
      observer.observe(canvas);
      document.addEventListener("visibilitychange", sync);
      window.addEventListener("pointermove", onPointerMove, { passive: true });
      document.addEventListener("pointerleave", onPointerLeave);
      window.addEventListener("blur", onPointerLeave);
      sync();
    }

    window.addEventListener("resize", onResize, { passive: true });
    window.addEventListener("scroll", measure, { passive: true });
    reduceMotion.addEventListener("change", onMotionPreferenceChange);
  }

  for (const canvas of document.querySelectorAll<HTMLCanvasElement>(
    "canvas.dither-field",
  )) {
    init(canvas);
  }
</script>
