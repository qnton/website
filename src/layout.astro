---
import "@/globals.css";

import instrumentSerif from "@/instrument-serif.woff2?url";
import satoshiVariable from "@/satoshi-variable.woff2?url";

interface Props {
  title: string;
  description: string;
  robots?: string;
  noStructuredData?: boolean;
}

const { title, description, robots, noStructuredData = false } = Astro.props;

const origin = Astro.site!.origin;
const path =
  Astro.url.pathname.length > 1 ? Astro.url.pathname.replace(/\/$/, "") : "";
const canonicalUrl = new URL(path || "/", `${origin}/`).href;
const ogImageUrl = `${origin}/og.png`;

const criticalFonts = [instrumentSerif, satoshiVariable];

const personId = `${origin}/#person`;
const structuredDataJson = JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Person",
      "@id": personId,
      name: "Anton Werschinin",
      alternateName: ["qnton", "qnt.one"],
      url: `${origin}/`,
      image: ogImageUrl,
      email: "hello@qnt.one",
      sameAs: ["https://github.com/qnton", "https://www.linkedin.com/in/qnton"],
    },
    {
      "@type": "WebSite",
      "@id": `${origin}/#website`,
      url: origin,
      name: "qnt.one",
      description,
      inLanguage: "en",
      publisher: { "@id": personId },
    },
  ],
});
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta content="width=device-width,initial-scale=1" name="viewport" />
    {
      criticalFonts.map((href) => (
        <link
          rel="preload"
          href={href}
          as="font"
          type="font/woff2"
          crossorigin="anonymous"
        />
      ))
    }
    <title>{title}</title>
    <meta content={description} name="description" />
    {robots && <meta content={robots} name="robots" />}
    <meta content="#000000" name="theme-color" />
    <link rel="canonical" href={canonicalUrl} />
    <meta content="website" property="og:type" />
    <meta content={title} property="og:title" />
    <meta content={description} property="og:description" />
    <meta content={canonicalUrl} property="og:url" />
    <meta content="qnt.one" property="og:site_name" />
    <meta content="en_US" property="og:locale" />
    <meta content={ogImageUrl} property="og:image" />
    <meta content="1200" property="og:image:width" />
    <meta content="630" property="og:image:height" />
    <meta content="image/png" property="og:image:type" />
    <meta content={title} property="og:image:alt" />
    <meta content="summary_large_image" name="twitter:card" />
    <meta content="@qnton" name="twitter:creator" />
    {
      !noStructuredData && (
        <script type="application/ld+json" set:html={structuredDataJson} />
      )
    }
  </head>
  <body>
    <main
      class="flex min-h-dvh flex-col px-[clamp(1.5rem,6vw,4rem)] pt-[clamp(3rem,12vh,8rem)] pb-10 text-left"
      id="main-content"
    >
      <div class="max-w-[36rem] flex-1">
        <slot />
      </div>
    </main>
  </body>
</html>
