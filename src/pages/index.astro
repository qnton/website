---
import Layout from "@/components/layout.astro";
---

<Layout
  description="Anton Werschinin is a developer and designer behind qnt.one. For focused collaboration, get in touch — I also go by qnton online."
  title="Anton Werschinin — qnt.one"
>
  <p
    class="reveal font-satoshi-medium text-[0.6875rem] tracking-[0.26em] text-[oklch(58%_0_0)] uppercase"
    style="--i: 0"
  >
    Get in touch
  </p>

  <h1
    class="reveal font-instrument-serif text-text-primary mt-5 text-[clamp(2.75rem,8vw,4.25rem)] leading-[1.05] font-normal tracking-[-0.02em]"
    style="--i: 1"
  >
    Work with me
  </h1>

  <p
    class="reveal font-satoshi-light text-text-muted mt-6 max-w-lg text-base leading-relaxed md:text-lg"
    style="--i: 2"
  >
    I'm Anton Werschinin. Have a project in mind? I take on a select number of
    clients each year to ensure focused, high-quality collaboration.
  </p>

  <div class="reveal mt-12 md:mt-16" style="--i: 3">
    <a
      class="group font-instrument-serif text-text-primary relative inline-flex max-w-full items-baseline gap-2 pb-1 text-[clamp(1.75rem,5vw,2.75rem)] leading-none tracking-[-0.02em] no-underline before:absolute before:inset-x-0 before:bottom-0 before:h-px before:bg-[oklch(96%_0_0/0.28)] after:absolute after:inset-x-0 after:bottom-0 after:h-px after:origin-left after:scale-x-0 after:bg-[oklch(96%_0_0)] after:transition-transform after:duration-[450ms] after:ease-[cubic-bezier(0.22,1,0.36,1)] hover:after:scale-x-100 focus-visible:after:scale-x-100"
      data-obfuscation="0"
      href="mailto:hello@qnt.one"
    >
      <span class="min-w-0 break-all">hello@qnt.one</span>
      <span
        class="inline-flex shrink-0 translate-y-[0.08em] self-center transition-transform duration-300 ease-[cubic-bezier(0.22,1,0.36,1)] group-hover:translate-x-[0.12em] group-hover:translate-y-[0.04em] group-focus-visible:translate-x-[0.12em] group-focus-visible:translate-y-[0.04em]"
        aria-hidden="true"
      >
        <svg
          class="size-[0.55em] md:size-[0.5em]"
          fill="none"
          height="24"
          viewBox="0 0 24 24"
          width="24"
          xmlns="http://www.w3.org/2000/svg"
        >
          <path
            d="M6 18L18 6M18 6H9M18 6V15"
            stroke="currentColor"
            stroke-linecap="round"
            stroke-linejoin="round"
            stroke-width="1.25"></path>
        </svg>
      </span>
    </a>
  </div>
</Layout>
